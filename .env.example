# k0n hunter — optional environment variables.
# Copy to .env (gitignored) and fill in. Nothing here is required to run;
# if unset, the agent asks for what it needs per engagement.

# Your bug-bounty platform handle — used for the identifying User-Agent,
# journal attribution, and blue-team deconfliction.
# If your engagement scope.md already sets a handle, that one wins.
RESEARCHER_HANDLE=

# Out-of-band interaction domain for blind SSRF / OOB command-injection
# callbacks (e.g. an interactsh server you control). Leave blank to be
# prompted when a lane actually needs it.
OOB_CALLBACK_DOMAIN=
